# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it holds secrets.

# ---- Site ----
# Public URL of the site (used for Paystack's return link). Leave empty locally.
NEXT_PUBLIC_BASE_URL=

# ---- Admin (/admin/orders) ----
# Long password you'll type to log in.
ADMIN_PASSWORD=
# Random secret used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ---- Paystack (dashboard.paystack.com → Settings → API Keys & Webhooks) ----
# Use the sk_test_... key until launch. If empty on your computer, a fake payment flow is used.
PAYSTACK_SECRET_KEY=

# ---- Supabase (supabase.com → Project Settings → API) ----
# If empty, orders are saved to data/orders.json on your computer.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email via Resend (resend.com → API Keys) ----
RESEND_API_KEY=
EMAIL_FROM="B&GV <onboarding@resend.dev>"
